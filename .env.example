# Copy to .env and fill in values for your own repository. Keep .env private.
ANTHROPIC_API_KEY=
# Alternatively set CLAUDE_CODE_USE_BEDROCK=1, AWS_REGION, and AWS_BEARER_TOKEN_BEDROCK.
CLAUDE_CODE_USE_BEDROCK=
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
IMPLEMENT_MODEL=
CHAT_MODEL=

GLAB_TOKEN=
CHAT_GLAB_TOKEN=
PIPELINE_GLAB_TOKEN=
GITLAB_HOST=gitlab.com
GITLAB_PROJECT_PATH=your-group/your-repository
REPO_URL=https://gitlab.com/your-group/your-repository.git
TARGET_BRANCH=main
AUTO_SPAWN=false
WEBHOOK_SECRET=
CHAT_USER=admin
CHAT_TOKEN=
ALLOWED_ORIGINS=

# The acceptance pipeline currently validates .NET solutions with TRX results.
# Set these before submitting pipeline tickets. Ordinary tasks and chat can omit them.
DOTNET_SOLUTION=
DOTNET_PRODUCTION_PROJECT=
TEST_PROJECT_PREFIX=tests/

# Optional integrations.
SONAR_HOST_URL=
SONAR_TOKEN=
SONAR_PROJECT_KEY=
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECTS_FILTER=
RAGFLOW_MCP_URL=
TEAMS_WEBHOOK_URL=
TEAMS_CHAT_EXPORT_DIR=
TEAMS_CHAT_LABEL=Team Chat
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=
MSSQL_SCHEMA=dbo
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
